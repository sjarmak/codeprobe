    {
      "artifact": "`codeprobe-mcp-*.json`"
    },
    {
      "artifact": "Task worktrees"
    },
    {
      "artifact": "Per-slot agent session directories"
    },
    {
      "artifact": "Scoring temp directories"
    },
    {
      "artifact": "`SNAPSHOT_DIR`"
    },
    {
      "artifact": "`evidence`"
    },
    {
      "artifact": "Export directories"
    },
    {
      "artifact": "CI logs, terminal transcripts, shell history, and backups"
    }
  ],
  "images": [
    {
      "name": "codeprobe-agent:0.14.0",
      "constant": "DEFAULT_AGENT_IMAGE",
      "dockerfile": "src/codeprobe/sandbox/Dockerfile.agent",
      "base_image_name": "node:22-bookworm-slim",
      "base_image": "node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3",
      "supply_chain_contract": {
        "base_image_pin": "sha256-digest",
        "runtime_user": "non-root",
        "required_phrases": [
          "base images are pinned by SHA-256 digest",
          "Debian package installation uses a dated snapshot",
          "Claude Code version and npm integrity are pinned",
          "images declare the non-root `codeprobe` user",
          "release workflow emits SBOM and provenance attestations",
          "scans both images",
          "signs their immutable digests"
        ]
      }
    },
    {
      "name": "codeprobe-scoring:0.14.0",
      "constant": "DEFAULT_SCORING_IMAGE",
      "dockerfile": "src/codeprobe/sandbox/Dockerfile.scoring",
      "base_image_name": "debian:bookworm-slim",
      "base_image": "debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818",
      "supply_chain_contract": {
        "base_image_pin": "sha256-digest",
        "runtime_user": "non-root",
        "required_phrases": [
          "base images are pinned by SHA-256 digest",
          "Debian package installation uses a dated snapshot",
          "images declare the non-root `codeprobe` user",
          "release workflow emits SBOM and provenance attestations",
          "scans both images",
          "signs their immutable digests"
        ]
      }
    }
  ],
  "commands": [
    {
      "command": "codeprobe bootstrap",
      "help": ["bootstrap"],
      "required_help_tokens": [
        "--agent-image",
        "--scoring-image",
        "--agent-archive",
        "--scoring-archive",
        "--engine"
      ]
    },
    {
      "command": "codeprobe run . --offline --offline-expected-run-duration 1h",
      "help": ["run"],
      "required_help_tokens": [
        "--offline",
        "--offline-expected-run-duration"
      ]
    },
    {
      "command": "codeprobe check-infra offline --json",
      "help": ["check-infra", "offline"],
      "required_help_tokens": [
        "--expected-run-duration",
        "--backend",
        "--json"
      ]
    },
    {
      "command": "codeprobe purge .",
      "help": ["purge"],
      "required_help_tokens": [
        "--older-than",
        "--all",
        "--yes"
      ]
    },
    {
      "command": "codeprobe purge . --yes",
      "help": ["purge"],
      "required_help_tokens": [
        "--yes"
      ]
    },
    {
      "command": "codeprobe purge . --older-than 30 --yes",
      "help": ["purge"],
      "required_help_tokens": [
        "--older-than",
        "--yes"
      ]
    },
    {
      "command": "codeprobe purge . --all --yes",
      "help": ["purge"],
      "required_help_tokens": [
        "--all",
        "--yes"
      ]
    },
    {
      "command": "codeprobe snapshot create EXPERIMENT_DIR --out SNAPSHOT_DIR --redact hashes-only",
      "help": ["snapshot", "create"],
      "required_help_tokens": [
        "--out",
        "--redact",
        "--allow-source-in-export"
      ]
    },
    {
      "command": "codeprobe snapshot verify SNAPSHOT_DIR",
      "help": ["snapshot", "verify"],
      "required_help_tokens": [
        "--signing-key"
      ]
    },
    {
      "command": "codeprobe snapshot evidence preview request.json --no-json",
      "help": ["snapshot", "evidence", "preview"],
      "required_help_tokens": [
        "--no-json"
      ]
    },
    {
      "command": "codeprobe snapshot evidence export request.json --out evidence --approve sha256:DIGEST --no-json",
      "help": ["snapshot", "evidence", "export"],
      "required_help_tokens": [
        "--out",
        "--approve",
        "--no-json"
      ]
    },
    {
      "command": "codeprobe snapshot evidence validate evidence --expect sha256:DIGEST --no-json",
      "help": ["snapshot", "evidence", "validate"],
      "required_help_tokens": [
        "--expect",
        "--no-json"
      ]
    }
  ],
