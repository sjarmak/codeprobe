  "security_claims": [
    {
      "id": "local_artifacts_cleartext",
      "required_phrases": [
        "cleartext",
        "operator-managed encrypted storage",
        "CodeProbe does not encrypt local run artifacts at rest"
      ],
      "checks": [
        "purge_cleartext_disclosure"
      ]
    },
    {
      "id": "purge_scope",
      "required_phrases": [
        ".codeprobe/",
        "codeprobe-mcp-*.json",
        "never touches your source tree",
        "does not delete snapshots, evidence bundles, export directories, task worktrees",
        "per-slot agent session directories, scoring temp directories",
        "CI logs, terminal transcripts, shell history, or backups"
      ],
      "checks": [
        "purge_tempfile_pattern",
        "purge_scoped_artifacts"
      ]
    },
    {
      "id": "agent_container_network",
      "required_phrases": [
        "--network=bridge",
        "does not restrict agent-container bridge egress by destination"
      ],
      "checks": [
        "agent_container_network_bridge"
      ]
    },
    {
      "id": "bootstrap_egress",
      "required_phrases": [
        "`codeprobe bootstrap`",
        "configured OCI registry",
        "archive mode requires no network egress"
      ],
      "checks": [
        "bootstrap_egress_matches_implementation"
      ]
    },
    {
      "id": "agent_container_mount_policy",
      "required_phrases": [
        "per-task slot worktree",
        "per-slot `CLAUDE_CONFIG_DIR`",
        "MCP config temp file"
      ],
      "checks": [
        "agent_container_mounts_expected_paths"
      ]
    },
    {
      "id": "credential_container_flow",
      "required_phrases": [
        "valueless `-e` arguments",
        "secret values do not appear in the container argv"
      ],
      "checks": [
        "agent_container_valueless_secret_args"
      ]
    },
    {
      "id": "private_ca_container_mount",
      "required_phrases": [
        "validated private CA files and directories",
        "read-only under `/etc/codeprobe/ca`",
        "rewrites the container environment values"
      ],
      "checks": [
        "agent_container_mounts_private_ca_paths"
      ]
    },
    {
      "id": "claude_session_mirror",
      "required_phrases": [
        "credential files are private regular files",
        "hardlink is used when possible",
        "read-mostly host configuration entries remain symlinks"
      ],
      "checks": [
        "claude_session_private_credentials"
      ]
    },
    {
      "id": "scoring_container_network",
      "required_phrases": [
        "--network=none"
      ],
      "checks": [
        "scoring_container_network_none"
      ]
    },
    {
      "id": "container_hardening_limits",
      "required_phrases": [
        "containment, not a hardened multi-tenant sandbox",
        "default seccomp profile",
        "--cap-drop=ALL",
        "--security-opt=no-new-privileges",
        "--read-only",
        "--cpus=2",
        "--memory=4g",
        "--pids-limit=256",
        "non-root `codeprobe` user"
      ],
      "checks": [
        "agent_container_runtime_hardening",
        "scoring_container_runtime_hardening"
      ]
    },
    {
      "id": "snapshot_default",
      "required_phrases": [
        "hashes-only"
      ],
      "checks": [
        "snapshot_default_hashes_only"
      ]
    },
    {
      "id": "evidence_bundle_allowlist",
      "required_phrases": [
        "fixed five-file bundle",
        "excludes file names, file sizes, prompts, patches, traces",
        "task-level results, raw diagnostics, and free-form identifying text"
      ],
      "checks": [
        "evidence_bundle_fixed_allowlist"
      ]
    },
    {
      "id": "trace_redaction",
      "required_phrases": [
        "[REDACTED-ENV]",
        "[REDACTED-AUTH]"
      ],
      "checks": [
        "trace_redaction_records_env_and_auth"
      ]
    },
    {
      "id": "offline_guard",
      "required_phrases": [
        "CODEPROBE_OFFLINE=1",
        "no socket-level interception"
      ],
      "checks": [
        "offline_guard_is_env_gated"
      ]
    },
    {
      "id": "host_consent",
      "required_phrases": [
        "--uncontained"
      ],
      "checks": [
        "host_fallback_requires_uncontained"
      ]
    },
    {
      "id": "application_and_ci_logs",
      "required_phrases": [
        "Application logs are stdout and stderr",
        "CI logs, terminal transcripts, shell history, and backups",
        "CodeProbe does not provide a central log store or log-retention policy"
      ],
      "checks": []
    }
  ]
}
