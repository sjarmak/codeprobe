{
  "schema_version": 1,
  "documents": [
    "SECURITY.md",
    "README.md",
    "docs/security/enterprise_deployment.md"
  ],
  "provider_neutral_documents": [
    "SECURITY.md",
    "docs/security/enterprise_deployment.md"
  ],
  "provider_neutral_forbidden_terms": [
    "sourcegraph",
    "field_engineering",
    "solutions_engineering",
    "cp-zca-pilot",
    "codeprobe-2z76",
    "participant_",
    "other_sourcegraph_personnel"
  ],
  "repository_paths": [
    "SECURITY.md",
    "README.md",
    "pyproject.toml",
    "docs/security/enterprise_deployment.md",
    "docs/security/enterprise_inventory.json",
    "docs/SNAPSHOT_REDACTION.md",
    "docs/EVIDENCE_BUNDLE.md",
    "docs/adapters.md",
    "src/codeprobe/adapters/_base.py",
    "src/codeprobe/cli/bootstrap_cmd.py",
    "src/codeprobe/cli/check_infra.py",
    "src/codeprobe/cli/purge_cmd.py",
    "src/codeprobe/cli/run_cmd.py",
    "src/codeprobe/core/containment.py",
    "src/codeprobe/core/scoring/sandbox.py",
    "src/codeprobe/net/credential_ttl.py",
    "src/codeprobe/net/offline.py",
    "src/codeprobe/sandbox/agent_container.py",
    "src/codeprobe/sandbox/image_bootstrap.py",
    "src/codeprobe/sandbox/image_config.py",
    "src/codeprobe/sandbox/runner.py",
    "src/codeprobe/sandbox/Dockerfile.agent",
    "src/codeprobe/sandbox/Dockerfile.scoring",
    "src/codeprobe/snapshot/redact.py",
    "src/codeprobe/trace/content_policy.py",
    "src/codeprobe/trace/store.py",
    "tests/lint/test_enterprise_security_docs.py"
  ],
  "images": [
    {
      "name": "codeprobe-agent:0.13.0",
      "constant": "DEFAULT_AGENT_IMAGE",
      "dockerfile": "src/codeprobe/sandbox/Dockerfile.agent"
    },
    {
      "name": "codeprobe-scoring:0.13.0",
      "constant": "DEFAULT_SCORING_IMAGE",
      "dockerfile": "src/codeprobe/sandbox/Dockerfile.scoring"
    }
  ],
  "commands": [
    {
      "command": "codeprobe bootstrap",
      "help": ["bootstrap"],
      "required_help_tokens": [
        "--agent-image",
        "--scoring-image",
        "--agent-archive",
        "--scoring-archive",
        "--engine"
      ]
    },
    {
      "command": "codeprobe run . --offline --offline-expected-run-duration 1h",
      "help": ["run"],
      "required_help_tokens": ["--offline", "--offline-expected-run-duration"]
    },
    {
      "command": "codeprobe check-infra offline --json",
      "help": ["check-infra", "offline"],
      "required_help_tokens": ["--expected-run-duration", "--backend", "--json"]
    },
    {
      "command": "codeprobe purge .",
      "help": ["purge"],
      "required_help_tokens": ["--older-than", "--all", "--yes"]
    },
    {
      "command": "codeprobe purge . --yes",
      "help": ["purge"],
      "required_help_tokens": ["--yes"]
    },
    {
      "command": "codeprobe purge . --older-than 30 --yes",
      "help": ["purge"],
      "required_help_tokens": ["--older-than", "--yes"]
    },
    {
      "command": "codeprobe purge . --all --yes",
      "help": ["purge"],
      "required_help_tokens": ["--all", "--yes"]
    },
    {
      "command": "codeprobe snapshot create EXPERIMENT_DIR --out SNAPSHOT_DIR --redact hashes-only",
      "help": ["snapshot", "create"],
      "required_help_tokens": ["--out", "--redact", "--allow-source-in-export"]
    },
    {
      "command": "codeprobe snapshot verify SNAPSHOT_DIR",
      "help": ["snapshot", "verify"],
      "required_help_tokens": ["--signing-key"]
    },
    {
      "command": "codeprobe snapshot evidence preview request.json --no-json",
      "help": ["snapshot", "evidence", "preview"],
      "required_help_tokens": ["--no-json"]
    },
    {
      "command": "codeprobe snapshot evidence export request.json --out evidence --approve sha256:DIGEST --no-json",
      "help": ["snapshot", "evidence", "export"],
      "required_help_tokens": ["--out", "--approve", "--no-json"]
    },
    {
      "command": "codeprobe snapshot evidence validate evidence --expect sha256:DIGEST --no-json",
      "help": ["snapshot", "evidence", "validate"],
      "required_help_tokens": ["--expect", "--no-json"]
    }
  ],
  "environment_variables": [
    {
      "name": "ANTHROPIC_API_KEY",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "CLAUDE_CODE_OAUTH_TOKEN",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "CLAUDE_CONFIG_DIR",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "OPENAI_API_KEY",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "COPILOT_GITHUB_TOKEN",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "GH_TOKEN",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "GITHUB_TOKEN",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "COPILOT_OFFLINE",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "COPILOT_PROVIDER_BASE_URL",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "COPILOT_PROVIDER_API_KEY",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "COPILOT_PROVIDER_TYPE",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "COPILOT_MODEL",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "ANTHROPIC_BASE_URL",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "ANTHROPIC_AUTH_TOKEN",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "HTTP_PROXY",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "HTTPS_PROXY",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "NO_PROXY",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "ALL_PROXY",
