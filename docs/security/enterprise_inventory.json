  "local_artifact_paths": [
    {
      "path": ".codeprobe/"
    },
    {
      "path": ".codeprobe/<experiment>/runs/"
    },
    {
      "path": ".codeprobe/<experiment>/runs/trace.db"
    },
    {
      "path": ".codeprobe/<experiment>/runs/<config>/<task>/"
    },
    {
      "path": ".codeprobe/<experiment>/runs/<config>/<task>/agent_output.txt"
    },
    {
      "path": ".codeprobe/<experiment>/runs/<config>/<task>/agent_error.txt"
    },
    {
      "path": "trace.db"
    },
    {
      "path": "codeprobe-mcp-*.json"
    },
    {
      "path": "SNAPSHOT_DIR"
    },
    {
      "path": "evidence"
    }
  ],
