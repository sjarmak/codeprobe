    {
      "name": "https_proxy",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "no_proxy",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "all_proxy",
      "checks": ["adapter_whitelist", "container_passthrough"]
    },
    {
      "name": "SSL_CERT_FILE",
      "checks": ["adapter_whitelist", "container_excluded"]
    },
    {
      "name": "SSL_CERT_DIR",
      "checks": ["adapter_whitelist", "container_excluded"]
    },
    {
      "name": "REQUESTS_CA_BUNDLE",
      "checks": ["adapter_whitelist", "container_excluded"]
    },
    {
      "name": "CURL_CA_BUNDLE",
      "checks": ["adapter_whitelist", "container_excluded"]
    },
    {
      "name": "NODE_EXTRA_CA_CERTS",
      "checks": ["adapter_whitelist", "container_excluded"]
    },
    {
      "name": "CODEPROBE_OFFLINE",
      "checks": ["offline_helper", "run_sets_offline"]
    },
    {
      "name": "CODEPROBE_CONTAINER_CONFIG",
      "checks": ["container_config"]
    },
    {
      "name": "CODEPROBE_SANDBOX",
      "checks": ["adapter_whitelist", "sandbox_helper"]
    },
    {
      "name": "CODEPROBE_SIGNING_KEY",
      "checks": ["snapshot_signing_key"]
    },
    {
      "name": "AWS_SESSION_EXPIRATION",
      "checks": ["credential_ttl"]
    },
    {
      "name": "AWS_CREDENTIAL_EXPIRATION",
      "checks": ["credential_ttl"]
    },
    {
      "name": "GOOGLE_APPLICATION_CREDENTIALS_TOKEN_EXPIRY",
      "checks": ["credential_ttl"]
    },
    {
      "name": "AZURE_TOKEN_EXPIRES_ON",
      "checks": ["credential_ttl"]
    }
  ],
  "security_claims": [
    {
      "id": "local_artifacts_cleartext",
      "required_phrases": [
        "cleartext",
        "operator-managed encrypted storage",
        "CodeProbe does not encrypt local run artifacts at rest"
      ],
      "checks": ["purge_cleartext_disclosure"]
    },
    {
      "id": "purge_scope",
      "required_phrases": [
        ".codeprobe/",
        "codeprobe-mcp-*.json",
        "never touches your source tree"
      ],
      "checks": ["purge_tempfile_pattern"]
    },
    {
      "id": "agent_container_network",
      "required_phrases": ["--network=bridge"],
      "checks": ["agent_container_network_bridge"]
    },
    {
      "id": "scoring_container_network",
      "required_phrases": ["--network=none"],
      "checks": ["scoring_container_network_none"]
    },
    {
      "id": "snapshot_default",
      "required_phrases": ["hashes-only"],
      "checks": ["snapshot_default_hashes_only"]
    },
    {
      "id": "trace_redaction",
      "required_phrases": ["[REDACTED-ENV]", "[REDACTED-AUTH]"],
      "checks": ["trace_redaction_records_env_and_auth"]
    },
    {
      "id": "offline_guard",
      "required_phrases": ["CODEPROBE_OFFLINE=1", "no socket-level interception"],
      "checks": ["offline_guard_is_env_gated"]
    },
    {
      "id": "host_consent",
      "required_phrases": ["--uncontained"],
      "checks": ["host_fallback_requires_uncontained"]
    }
  ]
}
