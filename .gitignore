.beads/

# Claude Code local config and CodeGraph (development-only), except the five
# product skills below: they ship in the sdist (MANIFEST.in) and are enforced
# by tests/skills/test_skill_cli_alignment.py. Git cannot re-include a path
# under an excluded parent directory, hence `.claude/*` rather than `.claude/`.
# Machine-local agent skills share the .claude/skills/ namespace and stay
# ignored. Negations are per-file, not per-directory: un-ignoring the skill
# directory itself would silently make any stray file dropped in there (scratch
# scripts, debug output) trackable.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/codeprobe-calibrate/
.claude/skills/codeprobe-calibrate/*
!.claude/skills/codeprobe-calibrate/SKILL.md
!.claude/skills/codeprobe-check-infra/
.claude/skills/codeprobe-check-infra/*
!.claude/skills/codeprobe-check-infra/SKILL.md
!.claude/skills/codeprobe-interpret/
.claude/skills/codeprobe-interpret/*
!.claude/skills/codeprobe-interpret/SKILL.md
!.claude/skills/codeprobe-mine/
.claude/skills/codeprobe-mine/*
!.claude/skills/codeprobe-mine/SKILL.md
!.claude/skills/codeprobe-run/
.claude/skills/codeprobe-run/*
!.claude/skills/codeprobe-run/SKILL.md
.codegraph/

# Internal working documents (PRDs and premortems)
prd_*.md
premortem_*.md
docs/prd/

# E2E run artifacts (ephemeral, regenerated by codeprobe run)
e2e-*/
.codeprobe-worktrees-*/

# Agent-orchestration session debris at repo root (per-session scratch dirs,
# local run outputs, per-bead git worktrees) — never source, never tracked
codeprobe-*/
runs/
worktrees/

# GasCity infrastructure
city.toml
formulas/
hooks/
orders/
prompts/
.runtime/
.gc/

.brainstorm/
.codex/

# prd-build orchestration artifacts
.prd-build/

.gc-reports/

# pytest-cov parallel-mode temp files. `.coverage` above does not match the
# `.coverage.<host>.<pid>.<rand>` form, and a stray one left the working tree
# dirty, which `codeprobe run` refuses (DIRTY_CHECKOUT) — including the run
# the acceptance loop performs to produce release evidence.
.coverage.*

# Local scratch: agent skill staging and hand-mined probe corpora. Generated,
# never tracked, and same DIRTY_CHECKOUT hazard as above.
.agents/
probes/
